{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "barangay-officials.schema.json",
  "type": "object",
  "required": ["lastUpdated", "source", "officials"],
  "properties": {
    "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1 },
    "officials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["barangay", "name"],
        "properties": {
          "barangay": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
